@page "/Note"
@model MatCloud.Apps.Note.Pages.Note.IndexModel
@{
    ViewData["Title"] = Model.Folder ?? "Notizen";
    ViewData["PageSub"] = Model.Folder is null ? "Die Notizen von ThixNote – auf allen Geräten gleich." : "Ein Ordner deiner Notizen.";
    ViewData["Crumbs"] = Model.Folder is null
        ? new List<(string, string?)> { ("Notizen", null), ("Alle Notizen", null) }
        : new List<(string, string?)> { ("Notizen", "/Note"), (Model.Folder, null) };
    var newHref = Model.Folder is null ? "/Note/Edit" : "/Note/Edit?folder=" + Uri.EscapeDataString(Model.Folder);
    List<string> subfolders = Model.Folder is null ? [] : Model.Result.Folders
        .Where(f => f.StartsWith(Model.Folder + "/", StringComparison.OrdinalIgnoreCase) && !f[(Model.Folder.Length + 1)..].Contains('/')).ToList();
}

@section TopActions {
    <partial name="_NoteTopActions" />
}

@* The list reloads itself when a device changes a note (note-live.js waits on /live/note/revision). *@
<div class="mat-list" data-live data-live-revision="@Model.Result.Latest">
    <partial name="_Toolbar" model="Model.Toolbar" />

    <div class="mc-live-region" data-live-region>
        @if (subfolders.Count > 0)
        {
            @* the folders inside this folder (the menu shows the top level) *@
            <nav class="mc-subfolders" aria-label="Ordner in @Model.Folder">
                @foreach (var f in subfolders)
                {
                    <a class="mc-subfolder" href="/Note?folder=@Uri.EscapeDataString(f)">@Ui.Icon("folder")<span>@f[(f.LastIndexOf('/') + 1)..]</span></a>
                }
            </nav>
        }

        @if (Model.Result.Items.Count == 0)
        {
            var first = Model.Result.Total == 0;
            <partial name="_Empty" model="@(new EmptyStateModel("file-text", first ? "Noch keine Notiz" : "Nichts gefunden",
                first ? "Verbinde ThixNote in den Einstellungen unter „Cloud“ mit dieser MatCloud, dann stehen deine Notizen hier. Oder schreib hier die erste."
                      : "Keine Notiz passt zur Suche oder zum Ordner.",
                first, newHref, "Neue Notiz", Model.Toolbar.UrlReset()))" />
        }
        else
        {
            @* the notes as cards, like the sheets of a notebook: title, the first lines of the text, folder and time *@
            <ul class="mc-note-grid" aria-label="Notizen">
                @foreach (var n in Model.Result.Items)
                {
                    var excerpt = n.Excerpt;
                    <li class="mc-note-card@(n.Kind == NoteKind.Protected ? " mc-note-card--locked" : "")">
                        <a class="mc-note-card__link" href="/Note/View?key=@n.Key">
                            <span class="mc-note-card__head">
                                <span class="mc-note-card__title">@n.Title</span>
                                <span class="mc-note-card__kind" title="@n.KindName">@Ui.Icon(NoteService.KindIcon(n.Kind))<span class="mat-sr-only">@n.KindName</span></span>
                            </span>
                            @if (n.Kind == NoteKind.Protected)
                            {
                                <span class="mc-note-card__locked">@Ui.Icon("lock")<span>Mit Kennwort geschützt – entsperren im Browser</span></span>
                            }
                            else if (excerpt.Count > 0)
                            {
                                <span class="mc-note-card__text">@string.Join("\n", excerpt)</span>
                            }
                            else
                            {
                                <span class="mc-note-card__text mc-note-card__text--empty">Noch leer</span>
                            }
                            <span class="mc-note-card__foot">
                                @if (n.Folder.Length > 0)
                                {
                                    <span class="mc-note-card__folder">@Ui.Icon("folder")<span>@n.Folder</span></span>
                                }
                                <span class="mc-note-card__time" title="@Dates.Stamp(n.UpdatedDate) @n.Where">@Dates.Short(n.UpdatedDate)</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="@newHref">@Ui.Icon("plus")<span>Neue Notiz</span></a>
        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-open="note-folder">@Ui.Icon("folder")<span>Neuer Ordner …</span></button>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="note-folder" aria-labelledby="note-folder-title">
        <form method="post" asp-page-handler="Folder" class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("folder")
                <h2 class="mat-dialog__title" id="note-folder-title">Neuer Ordner</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <mc-field name="NewFolder" label="Name" required value="@(Model.Folder is null ? "" : Model.Folder + "/")" maxlength="500"
                          hint="Ein Ordner in einem Ordner: mit / getrennt (Arbeit/Projekte)." msg-required="Bitte einen Namen eingeben." />
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Anlegen</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </form>
    </dialog>
</div>

@section Scripts {
    <script src="~/_content/MatCloud.Apps.Note/js/note-live.js" asp-append-version="true"></script>
}
