@page "/Note/View"
@model MatCloud.Apps.Note.Pages.Note.ViewModel
@{
    var note = Model.Note;
    ViewData["Title"] = note.Title;
    ViewData["PageSub"] = $"{note.KindName}{(note.Folder.Length > 0 ? " · " + note.Folder : "")} · geändert {Dates.Stamp(note.UpdatedDate)} {note.Where}";
    var crumbs = new List<(string, string?)> { ("Notizen", "/Note") };
    if (note.Folder.Length > 0)
    {
        crumbs.Add((note.Folder, "/Note?folder=" + Uri.EscapeDataString(note.Folder)));
    }

    crumbs.Add((note.Title, null));
    ViewData["Crumbs"] = crumbs;
}

@section TopActions {
    <partial name="_NoteTopActions" />
}

@if (note.Kind == NoteKind.Protected)
{
    @* A protected note: decrypted only here in the browser (note-crypt.js); the password and the text never go to the server. *@
    <div class="mc-protected" data-note-crypt data-bytes="@note.Bytes">
        <form class="mat-card mat-form" data-note-unlock novalidate>
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("lock")Geschützte Notiz</h2></div>
            <div class="mat-card__body mat-form">
                <p class="mat-muted">Diese Notiz ist mit einem Kennwort verschlüsselt. Sie wird nur hier im Browser entsperrt – das Kennwort und der Text gehen nicht an den Server.</p>
                <div class="mat-field">
                    <label class="mat-label" for="note-password">Kennwort</label>
                    <input class="mat-input" id="note-password" type="password" autocomplete="current-password" required data-note-password />
                    <span class="mat-hint mc-crypt-error" data-note-error role="alert" hidden></span>
                </div>
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("key")<span>Entsperren</span></button>
                    <a class="mat-btn mat-btn--secondary" href="/Note">@Ui.Icon("back")<span>Zurück</span></a>
                </div>
            </div>
        </form>

        <form method="post" asp-page-handler="Protected" asp-route-key="@note.Key" class="mat-form" data-note-editor hidden>
            <input type="hidden" name="Bytes" data-note-bytes />
            <input type="hidden" name="BaseHash" value="@note.Hash" />
            <div class="mat-card">
                <div class="mat-card__body">
                    <label class="mat-label" for="note-plain">Text</label>
                    <textarea class="mat-input mc-note-editor" id="note-plain" rows="18" spellcheck="true" data-note-plain></textarea>
                    <span class="mat-hint">Beim Speichern wird die Notiz hier im Browser wieder mit demselben Kennwort verschlüsselt.</span>
                </div>
            </div>
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("lock")<span>Verschlüsselt speichern</span></button>
                <a class="mat-btn mat-btn--secondary" href="/Note/View?key=@note.Key">@Ui.Icon("x")<span>Sperren</span></a>
            </div>
        </form>
    </div>
}
else
{
    <article class="mat-card">
        <div class="mat-card__body mc-note-body">
            @if (Model.Html is not null)
            {
                <div class="mc-markdown">@Html.Raw(Model.Html)</div>
            }
            else
            {
                <pre class="mc-note-text">@note.Content</pre>
            }
        </div>
    </article>
}

<form method="post" asp-page-handler="Delete" asp-route-key="@note.Key" data-note-actions>
    <div class="mat-btn-row mc-btn-row">
        <a class="mat-btn mat-btn--primary" href="/Note/Edit?key=@note.Key">@Ui.Icon("edit")<span>@(note.Kind == NoteKind.Protected ? "Umbenennen" : "Bearbeiten")</span></a>
        @if (note.Kind != NoteKind.Protected)
        {
            <button type="button" class="mat-btn mat-btn--secondary mc-btn-collapse" data-copy="#note-source" aria-label="Text kopieren" data-tip="Text kopieren">@Ui.Icon("copy")<span>Kopieren</span></button>
        }
        <a class="mat-btn mat-btn--secondary mc-btn-collapse" href="/Note" aria-label="Zurück" data-tip="Zurück">@Ui.Icon("back")<span>Zurück</span></a>
        <span class="mat-btn-row__spacer"></span>
        <button type="submit" class="mat-btn mat-btn--danger mc-btn-collapse" aria-label="Löschen" data-tip="Löschen" data-confirm="Diese Notiz löschen? ThixNote legt sie auf deinen Geräten in den Papierkorb." data-confirm-ok="Löschen" data-confirm-danger>@Ui.Icon("trash")<span>Löschen</span></button>
    </div>
</form>

@if (note.Kind != NoteKind.Protected)
{
    <textarea id="note-source" class="mat-sr-only" readonly aria-hidden="true" tabindex="-1">@note.Content</textarea>
}

@section Scripts {
    @if (note.Kind == NoteKind.Protected)
    {
        <script src="~/_content/MatCloud.Apps.Note/js/note-crypt.js" asp-append-version="true"></script>
    }
}
