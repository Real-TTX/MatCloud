@page "/Calendar/Accounts"
@model MatCloud.Apps.Calendar.Pages.Calendar.AccountsModel
@{
    ViewData["Title"] = "Konten";
    ViewData["PageSub"] = "Wer deine Kalender abgleicht: die Computer mit ThixCalendar oder MatCloud – auch wenn kein Computer läuft.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Kalender", "/Calendar"), ("Konten", null) };
    ViewData["Width"] = "narrow";
    ViewData["GoogleInBrowser"] = Model.GoogleInBrowser;
    var icsOpen = !ViewData.ModelState.IsValid;
}

@section TopActions {
    <partial name="_CalendarTopActions" />
}

<div class="mc-accounts" data-live data-live-revision="@Model.Latest">
    <div class="mc-live-region" data-live-region>
        @if (Model.Accounts.Count == 0)
        {
            <partial name="_Empty" model="@(new EmptyStateModel("users", "Noch keine Konten",
                "Verbinde ThixCalendar in den Einstellungen unter „Cloud“ mit dieser MatCloud – oder verbinde unten ein Konto direkt hier.", true))" />
        }
        else
        {
            <ul class="mc-account-list" aria-label="Konten">
                @foreach (var a in Model.Accounts)
                {
                    <partial name="_CalendarAccount" model="a" />
                }
            </ul>
        }
    </div>
</div>

@* connect a new account here: it runs over MatCloud from the start *@
<section class="mc-connect" aria-labelledby="connect-title">
    <h2 class="mc-connect__title" id="connect-title">Konto verbinden</h2>
    <p class="mc-connect__text">MatCloud gleicht ein Konto, das du hier verbindest, selbst ab. Es erscheint auch in ThixCalendar auf deinen Computern – ohne dass sie sich anmelden müssen.</p>
    <div class="mc-connect__tiles">
        <a class="mc-connect__tile" href="/Calendar/Connect">
            <span class="mc-connect__icon" aria-hidden="true">@Ui.Icon("briefcase")</span>
            <span class="mc-connect__label"><strong>Microsoft 365</strong><small>Outlook.com, Exchange Online – Anmeldung mit einem Code</small></span>
            @Ui.Icon("chevron-right", "mc-connect__go")
        </a>
        @if (Model.GoogleInBrowser)
        {
            <a class="mc-connect__tile" href="/Calendar/Accounts?handler=Google">
                <span class="mc-connect__icon" aria-hidden="true">@Ui.Icon("globe")</span>
                <span class="mc-connect__label"><strong>Google Kalender</strong><small>Anmeldung bei Google in diesem Browser</small></span>
                @Ui.Icon("chevron-right", "mc-connect__go")
            </a>
        }
        else
        {
            <div class="mc-connect__tile is-off">
                <span class="mc-connect__icon" aria-hidden="true">@Ui.Icon("globe")</span>
                <span class="mc-connect__label"><strong>Google Kalender</strong>
                    <small>In ThixCalendar am Computer anmelden und „Über MatCloud“ wählen@(Model.GoogleFromComputer ? string.Empty : " (dafür fehlt dieser MatCloud noch die Google-Registrierung von ThixCalendar)"). Im Browser, sobald der Administrator unter Einstellungen den Google-Zugang einträgt.</small>
                </span>
            </div>
        }
        <a class="mc-connect__tile" href="#ics" data-ics-open>
            <span class="mc-connect__icon" aria-hidden="true">@Ui.Icon("link")</span>
            <span class="mc-connect__label"><strong>ICS-Abo</strong><small>Feiertage, Schulferien, Spielpläne – eine Adresse abonnieren (nur lesen)</small></span>
            @Ui.Icon("chevron-right", "mc-connect__go")
        </a>
    </div>

    <details class="mat-card mc-ics" id="ics" open="@icsOpen">
        <summary class="mc-ics__summary">@Ui.Icon("link")<span>ICS-Adresse abonnieren</span></summary>
        <form class="mat-form mat-card__body mc-ics__form" method="post" asp-page-handler="Ics" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <mc-field name="IcsUrl" kind="url" label="Adresse" required value="@Model.IcsUrl" placeholder="https://… oder webcal://…" msg-required="Bitte die Adresse des Abos eingeben." full />
            <mc-field name="IcsName" label="Name" optional value="@Model.IcsName" maxlength="100" placeholder="z. B. Feiertage" />
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Abonnieren</span></button>
            </div>
        </form>
    </details>
</section>

@section Scripts {
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-live.js" asp-append-version="true"></script>
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-accounts.js" asp-append-version="true"></script>
}
