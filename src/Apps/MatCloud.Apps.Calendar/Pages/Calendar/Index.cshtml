@page "/Calendar"
@model MatCloud.Apps.Calendar.Pages.Calendar.IndexModel
@{
    ViewData["Title"] = "Kalender";
    ViewData["PageSub"] = "Deine Kalender von ThixCalendar – auf allen Geräten gleich.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Kalender", null) };
    ViewData["Width"] = "wide";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
    var any = Model.Calendars.Count > 0;
}

@section TopActions {
    <partial name="_CalendarTopActions" />
}

@* The page reloads its grid when a device or the sync of MatCloud changes something (calendar-live.js waits on /live/calendar/revision). *@
<div class="mc-cal" data-live data-live-revision="@Model.Latest">
    @* ONE slim toolbar: ‹ Heute ›, the period, Woche | Monat *@
    <div class="mc-cal__bar" role="toolbar" aria-label="Zeitraum">
        <div class="mc-cal__nav">
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="@Model.Previous" aria-label="Zurück" data-tip="Zurück">@Ui.Icon("chevron-left")</a>
            <a class="mat-btn mat-btn--ghost" href="@Model.PeriodUrl(Model.Today)">Heute</a>
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="@Model.Next" aria-label="Weiter" data-tip="Weiter">@Ui.Icon("chevron-right")</a>
        </div>
        <h2 class="mc-cal__title">@Model.Title</h2>
        <div class="mat-seg" role="group" aria-label="Ansicht">
            <a class="mat-seg__btn" href="@Model.PeriodUrl(Model.Date, "week")" aria-pressed="@(Model.View == "week" ? "true" : "false")">Woche</a>
            <a class="mat-seg__btn" href="@Model.PeriodUrl(Model.Date, "month")" aria-pressed="@(Model.View == "month" ? "true" : "false")">Monat</a>
        </div>
    </div>

    <div class="mc-cal__body">
        <div class="mc-live-region mc-cal__main" data-live-region>
            @if (!any)
            {
                <partial name="_Empty" model="@(new EmptyStateModel("calendar", "Noch keine Kalender",
                    "Verbinde ThixCalendar in den Einstellungen unter „Cloud“ mit dieser MatCloud, oder verbinde hier unter „Konten“ ein Microsoft-, Google- oder ICS-Konto.",
                    true, "/Calendar/Accounts", "Konten öffnen"))" />
            }
            else if (Model.View == "week")
            {
                <ol class="mc-week" aria-label="Woche">
                    @foreach (var day in Model.Days())
                    {
                        var events = Model.On(day).ToList();
                        <li class="mc-week__day@(day == Model.Today ? " is-today" : "")@(day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? " is-weekend" : "")">
                            <h3 class="mc-week__head">
                                <span class="mc-week__name">@IndexModel.DayName(day)</span>
                                <span class="mc-week__date">@day.Day.</span>
                            </h3>
                            @if (events.Count == 0)
                            {
                                <p class="mc-week__none">Keine Termine</p>
                            }
                            else
                            {
                                <ul class="mc-week__events">
                                    @foreach (var e in events)
                                    {
                                        <li>
                                            <a class="mc-event@(e.Data.IsAllDay ? " mc-event--allday" : "")@(e.IsCancelled || e.IsDeclined ? " is-off" : "")" href="@e.EditUrl"
                                               data-color="@e.Calendar.Color" title="@e.Calendar.Name">
                                                <span class="mc-event__time">@(e.Data.IsAllDay ? "Ganztägig" : (e.StartLocal.Date < day ? "…" : e.StartLocal.ToString("HH:mm")))</span>
                                                <span class="mc-event__title">@e.Data.Title</span>
                                                @if (e.Data.Location.Length > 0)
                                                {
                                                    <span class="mc-event__where">@e.Data.Location</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <div class="mc-month" role="grid" aria-label="@Model.Title">
                    <div class="mc-month__row mc-month__names" role="row">
                        @foreach (var name in new[] { "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So" })
                        {
                            <span class="mc-month__name" role="columnheader">@name</span>
                        }
                    </div>
                    @foreach (var week in Model.Days().Chunk(7))
                    {
                        <div class="mc-month__row" role="row">
                            @foreach (var day in week)
                            {
                                var events = Model.On(day).ToList();
                                <div class="mc-month__day@(day.Month != Model.Month.Month ? " is-other" : "")@(day == Model.Today ? " is-today" : "")" role="gridcell">
                                    <a class="mc-month__date" href="@Model.PeriodUrl(day, "week")" aria-label="@GermanDates.Long(day, year: false)">@day.Day</a>
                                    @foreach (var e in events.Take(4))
                                    {
                                        <a class="mc-chip@(e.Data.IsAllDay ? " mc-chip--allday" : "")@(e.IsCancelled || e.IsDeclined ? " is-off" : "")" href="@e.EditUrl"
                                           data-color="@e.Calendar.Color" title="@e.TimeText · @e.Data.Title">
                                            @if (!e.Data.IsAllDay && e.StartLocal.Date == day)
                                            {
                                                <span class="mc-chip__time">@e.StartLocal.ToString("HH:mm")</span>
                                            }
                                            <span class="mc-chip__title">@e.Data.Title</span>
                                        </a>
                                    }
                                    @if (events.Count > 4)
                                    {
                                        <a class="mc-month__more" href="@Model.PeriodUrl(day, "week")">+@(events.Count - 4) weitere</a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (any)
        {
            @* the calendars: switched on and off here, the choice travels to ThixCalendar *@
            <aside class="mat-card mc-cal__list" aria-label="Meine Kalender">
                <div class="mat-card__body">
                    <h2 class="mc-cal__list-title">Meine Kalender</h2>
                    @foreach (var group in Model.Calendars.GroupBy(c => c.Account))
                    {
                        var first = group.First();
                        <h3 class="mc-cal__account">@first.AccountName</h3>
                        <ul class="mc-cal__calendars">
                            @foreach (var c in group)
                            {
                                <li>
                                    <form method="post" asp-page-handler="Show">
                                        <input type="hidden" name="key" value="@c.Key" />
                                        <input type="hidden" name="visible" value="@(c.IsVisible ? "false" : "true")" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="mc-cal__calendar@(c.IsVisible ? " is-on" : "")" data-color="@c.Color" aria-pressed="@(c.IsVisible ? "true" : "false")"
                                                data-tip="@(c.HasEvents ? (c.IsVisible ? "Ausblenden" : "Einblenden") : "Läuft über die Computer: die Termine sind nur in ThixCalendar")">
                                            <span class="mc-cal__dot" aria-hidden="true"></span>
                                            <span class="mc-cal__name">@c.Name</span>
                                            @if (!c.HasEvents)
                                            {
                                                @Ui.Icon("monitor", "mc-cal__hint")
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </aside>
        }
    </div>
</div>

@section Scripts {
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-colors.js" asp-append-version="true"></script>
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-live.js" asp-append-version="true"></script>
}
