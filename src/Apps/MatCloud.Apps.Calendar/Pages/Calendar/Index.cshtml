@page "/Calendar"
@model MatCloud.Apps.Calendar.Pages.Calendar.IndexModel
@{
    ViewData["Title"] = "Kalender";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Kalender", null) };
    ViewData["Width"] = "wide";
    ViewData["OwnHead"] = true;
    ViewData["PageClass"] = "mc-cal-page";
    var any = Model.Calendars.Count > 0;
}

@section TopActions {
    <partial name="_CalendarTopActions" />
}

@if (!any)
{
    <div class="mat-page__head">
        <div class="mat-page__title"><h1>Kalender</h1></div>
    </div>
    <partial name="_Empty" model="@(new EmptyStateModel("calendar", "Noch keine Kalender",
        "Verbinde ThixCalendar in den Einstellungen unter „Cloud“ mit dieser MatCloud, oder verbinde hier unter „Konten“ ein Microsoft-, Google- oder ICS-Konto.",
        true, "/Calendar/Accounts", "Konten öffnen"))" />
}
else
{
    @*
        MatUI's schedule (LIST-14) draws the calendar: ONE slim bar (Heute ‹ ›, the period, Tag | Woche | Monat | Agenda), the time grid below.
        calendar-schedule.js loads the events of what is shown (?handler=Events), gives them the colours of their calendars, keeps the address in step
        and loads again when a device or MatCloud's sync changes something (calendar-live.js with data-live-event tells it).
    *@
    <div class="mc-cal" data-live data-live-event data-live-revision="@Model.Latest">
        <h1 class="mat-sr-only">Kalender</h1>
        <section class="mat-schedule mc-schedule" data-schedule data-lazy data-week-numbers aria-label="Kalender"
                 data-view="@Model.View" data-views="day,week,month,agenda" data-date="@Model.Date.ToString("yyyy-MM-dd")"
                 data-day-start="7" data-day-end="20" data-agenda="week" data-empty-days
                 data-events-url="/Calendar?handler=Events" data-empty="In diesem Zeitraum steht nichts in den eingeblendeten Kalendern.">
            <noscript><p>Der Kalender braucht JavaScript. Die Termine stehen auch unter <a href="/Calendar/Events">Termine</a>.</p></noscript>
        </section>

        @* the calendars: switched on and off here, the choice travels to ThixCalendar on every computer *@
        <aside class="mc-cal__side" aria-label="Meine Kalender">
            <h2 class="mc-cal__side-title">Meine Kalender</h2>
            @foreach (var group in Model.Calendars.GroupBy(c => c.Account))
            {
                var first = group.First();
                <section class="mc-cal__group" aria-label="@first.AccountName">
                    <h3 class="mc-cal__account">
                        @Ui.Icon(IndexModel.KindIcon(first.Kind))
                        <span class="mc-cal__account-name">@first.AccountName</span>
                    </h3>
                    <ul class="mc-cal__calendars">
                        @foreach (var c in group)
                        {
                            <li>
                                <form method="post" asp-page-handler="Show" class="mc-cal__calendar@(c.HasEvents ? string.Empty : " is-elsewhere")" data-color="@c.Color" data-cal-toggle>
                                    <input type="hidden" name="key" value="@c.Key" />
                                    <input type="hidden" name="returnUrl" value="@Model.PeriodUrl(Model.Date)" data-return-url />
                                    <label class="mat-switch mc-cal__switch">
                                        <input type="checkbox" name="visible" value="true" @(c.IsVisible ? "checked" : null) />
                                        <span class="mat-switch__track"></span>
                                        <span class="mc-cal__name">@c.Name</span>
                                    </label>
                                    @if (!c.HasEvents)
                                    {
                                        <span class="mc-cal__hint" data-tip="Läuft über die Computer: die Termine sind nur in ThixCalendar">@Ui.Icon("monitor")</span>
                                    }
                                    <noscript><button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm">OK</button></noscript>
                                </form>
                            </li>
                        }
                    </ul>
                </section>
            }
            <p class="mc-cal__side-foot">
                <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Calendar/Accounts">@Ui.Icon("users")<span>Konten verwalten</span></a>
            </p>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-colors.js" asp-append-version="true"></script>
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-schedule.js" asp-append-version="true"></script>
    <script src="~/_content/MatCloud.Apps.Calendar/js/calendar-live.js" asp-append-version="true"></script>
}
