@page "/Clip"
@model MatCloud.Apps.Clip.Pages.Clip.IndexModel
@{
    ViewData["Title"] = "Verlauf";
    ViewData["PageSub"] = "Alles, was auf deinen Geräten kopiert wurde – durchsuchbar, auch Text aus Bildern.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Zwischenablage", null), ("Verlauf", null) };
}

@section TopActions {
    <partial name="_ClipTopActions" />
}

@* The list reloads itself when another device changes something (clip-live.js waits on /live/clip/revision). *@
<div class="mat-list" data-live data-live-revision="@Model.Result.Latest">
    <partial name="_Toolbar" model="Model.Toolbar" />

    <div class="mc-live-region" data-live-region>
        @if (Model.Result.Items.Count == 0)
        {
            var first = Model.Result.Total == 0;
            <partial name="_Empty" model="@(new EmptyStateModel("clipboard", first ? "Noch nichts kopiert" : "Nichts gefunden",
                first ? "Sobald du auf einem Gerät mit ThixClip etwas kopierst, erscheint es hier. Oder lege hier einen Eintrag an – er ist sofort auf allen Geräten."
                      : "Kein Eintrag passt zur Suche oder zu den Filtern.",
                first, "/Clip/Edit", "Neuer Eintrag", Model.Toolbar.UrlReset()))" />
        }
        else
        {
            <ul class="mat-itemlist mat-itemlist--inset mat-itemlist--lead-lg mc-clips" aria-label="Verlauf">
                @foreach (var group in Model.Groups)
                {
                    <li class="mat-itemlist__divider">@group.Heading <span class="mc-count">@(group.Items.Count == 1 ? "1 Eintrag" : $"{group.Items.Count} Einträge")</span></li>
                    @foreach (var c in group.Items)
                    {
                        <li class="mat-item mat-item--top mc-clip">
                            <a class="mat-item__main" href="/Clip/Edit?id=@c.Id">
                                <span class="mat-item__lead">
                                    @if (c.Kind == ClipKind.Image && c.HasImage)
                                    {
                                        <span class="mat-item__thumb mc-thumb"><img src="/live/clip/@c.Id/thumbnail" alt="" loading="lazy" decoding="async" width="56" height="56" /></span>
                                    }
                                    else
                                    {
                                        <span class="mat-item__tile">@Ui.Icon(ClipContent.KindIcon(c.Kind))</span>
                                    }
                                </span>
                                <span class="mat-item__body">
                                    @if (c.Kind == ClipKind.Image)
                                    {
                                        <span class="mat-item__title">Bild (PNG@(c.ImageWidth is null ? "" : $", {c.ImageWidth} × {c.ImageHeight}"))</span>
                                        @if (c.Preview.Length > 0)
                                        {
                                            <span class="mat-item__text mat-item__text--clamp">@c.Preview</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="mat-item__title @(c.Kind == ClipKind.Link ? "mc-link-text" : "")">@c.Preview</span>
                                    }
                                    <span class="mat-item__text mc-meta">
                                        @if (c.HasOcr)
                                        {
                                            <span class="mat-pill mat-pill--accent mc-pill" title="Text im Bild erkannt (durchsuchbar)">OCR</span>
                                        }
                                        @if (c.IsPinned)
                                        {
                                            <span class="mat-pill mat-pill--plain mc-pill">@Ui.Icon("pin")Angeheftet</span>
                                        }
                                        <span>@ClipContent.KindName(c.Kind)@(c.Source is null ? "" : " · " + c.Source)</span>
                                    </span>
                                </span>
                                <span class="mat-item__end"><span class="mat-item__note">@Dates.Short(Model.Toolbar.Sort == "created" ? c.CreatedDate : c.CopiedDate)</span></span>
                            </a>
                            <div class="mat-item__aside">
                                <form method="post" asp-page-handler="Favorite" asp-route-id="@c.Id" asp-route-on="@(!c.IsFavorite)">
                                    <input type="hidden" name="returnUrl" value="@Model.Here" />
                                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mc-star @(c.IsFavorite ? "is-on" : "")" aria-pressed="@(c.IsFavorite ? "true" : "false")"
                                            aria-label="@(c.IsFavorite ? "Aus den Favoriten nehmen" : "Zu den Favoriten")" data-tip="@(c.IsFavorite ? "Favorit" : "Zu den Favoriten")">@Ui.Icon("star")</button>
                                </form>
                            </div>
                        </li>
                    }
                }
            </ul>
        }

        <partial name="_Pager" model="Model.Pager" />
    </div>

    @* An empty history offers its first entry in the empty state; the actions are for a history that has entries. *@
    @if (Model.Result.Total > 0)
    {
        <div class="mat-actions">
            <a class="mat-btn mat-btn--primary" href="/Clip/Edit">@Ui.Icon("plus")<span>Neuer Eintrag</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="button" class="mat-btn mat-btn--danger" data-dialog-open="clips-clear">@Ui.Icon("trash")<span>Verlauf löschen …</span></button>
        </div>

        @* "Verlauf löschen" as in a browser: a range, then delete. The shortest range is chosen, so a quick Enter never takes more than the last hour. *@
        <dialog class="mat-dialog mat-dialog--sm" id="clips-clear" aria-labelledby="clips-clear-title">
            <form method="post" asp-page-handler="Clear" class="mat-dialog__form">
                <div class="mat-dialog__head">
                    @Ui.Icon("trash")
                    <h2 class="mat-dialog__title" id="clips-clear-title">Verlauf löschen</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-form">
                    <fieldset class="mat-field mat-fieldset">
                        <legend class="mat-label">Zeitraum</legend>
                        <div class="mat-options">
                            @foreach (var range in ClearRanges.Choices)
                            {
                                <label class="mat-option"><input type="radio" id="clips-clear-@range" name="range" value="@range" checked="@(range == ClearRange.LastHour)" /><span>@ClearRanges.Text(range)</span></label>
                            }
                        </div>
                    </fieldset>
                    <p class="mat-hint">Gelöscht wird, was im Zeitraum zuletzt kopiert wurde – auch auf allen Geräten. Favoriten und angeheftete Einträge bleiben.</p>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--danger">@Ui.Icon("trash")<span>Löschen</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                    </div>
                </div>
            </form>
        </dialog>
    }
</div>

@section Scripts {
    <script src="~/_content/MatCloud.Apps.Clip/js/clip-live.js" asp-append-version="true"></script>
}
