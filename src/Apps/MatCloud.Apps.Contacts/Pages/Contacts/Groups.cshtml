@page "/Contacts/Groups"
@model MatCloud.Apps.Contacts.Pages.Contacts.GroupsModel
@{
    ViewData["Title"] = "Kontaktgruppen";
    ViewData["PageSub"] = "Gruppen von Kontakten – in ThixContacts und ThixMail an alle auf einmal schreiben.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Kontakte", "/Contacts"), ("Kontaktgruppen", null) };
}

@section TopActions {
    <partial name="_ContactsTopActions" />
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Groups.Count == 0)
    {
        var first = Model.Toolbar.Total == 0;
        <partial name="_Empty" model="@(new EmptyStateModel("users", first ? "Noch keine Gruppe" : "Nichts gefunden",
            first ? "Eine Gruppe fasst Kontakte zusammen, etwa „Team“ oder „Familie“." : "Keine Gruppe passt zur Suche.", false, null, null, first ? null : Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <mc-table caption="Kontaktgruppen">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col" class="mat-num">Mitglieder</th>
                    <th scope="col"><span class="mat-sr-only">Bearbeiten</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Groups)
                {
                    <tr>
                        <td data-label="Name"><a href="/Contacts?group=@Uri.EscapeDataString(g.Key)" class="mc-contacts__link">@Ui.Icon("users")<span>@g.Name</span></a></td>
                        <td data-label="Mitglieder" class="mat-num">@g.Members.Count</td>
                        <td class="mat-num"><a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Contacts/Group?key=@Uri.EscapeDataString(g.Key)" aria-label="„@g.Name“ bearbeiten" data-tip="Bearbeiten">@Ui.Icon("edit")</a></td>
                    </tr>
                }
            </tbody>
        </mc-table>
    }

    <div class="mat-actions">
        <button type="button" class="mat-btn mat-btn--primary" data-dialog-open="group-new">@Ui.Icon("plus")<span>Neue Kontaktgruppe</span></button>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="group-new" aria-labelledby="group-new-title">
        <form method="post" asp-page-handler="Create" class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("users")
                <h2 class="mat-dialog__title" id="group-new-title">Neue Kontaktgruppe</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <mc-field name="NewName" label="Name" required maxlength="100" msg-required="Bitte einen Namen eingeben." />
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Anlegen</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </form>
    </dialog>
</div>
