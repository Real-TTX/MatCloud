@model string
@* The areas of the account (UI rule: one item with several areas has tabs): each tab is a page of its own. *@
<mc-tabs label="Konto">
    <mc-tab href="/Account" active="@(Model == "general")" icon="user">Allgemein</mc-tab>
    <mc-tab href="/Account/Security" active="@(Model == "security")" icon="lock">Sicherheit</mc-tab>
    <mc-tab href="/Account/Devices" active="@(Model == "devices")" icon="monitor">Geräte</mc-tab>
</mc-tabs>
