<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    MatCloud: the cloud of the Thix apps. The host: start-up, the pages of the platform (sign-in, account, devices, apps, administration),
    the platform contract (MatPlatform: /api), the migrations of the one database (core + every module) and the files of the browser.
    The app modules are referenced here and listed in Modules.cs.
  -->
  <PropertyGroup>
    <RootNamespace>MatCloud</RootNamespace>
    <AssemblyName>MatCloud</AssemblyName>
    <!-- Dates are formatted by the app itself (German, the time zone of the account): no ICU library is needed in the image. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatCloud.Core\MatCloud.Core.csproj" />
    <ProjectReference Include="..\Apps\MatCloud.Apps.Clip\MatCloud.Apps.Clip.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatCloud.Tests" />
  </ItemGroup>

</Project>
