@model string
@*
    The head of every page (with and without the menu): the viewport for the installed app (safe areas, no zoom into fields, the pinch zoom stays),
    the colours of the status bar that match the page background in light and dark, the PWA links, the toolkit. The pages of an app module wear the
    brand of their app (AppBrands): "Notizen · ThixNote", its favicon, its manifest (the app can be installed on its own).
*@
@{
    var brand = AppBrands.ForPath(Context.Request.Path.Value);
    var manifest = brand.IsCloud ? "/manifest.webmanifest" : brand.Home + "/manifest.webmanifest";
}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f5f4f1" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#151514" media="(prefers-color-scheme: dark)" />
<meta name="robots" content="noindex" />
<meta name="description" content="MatCloud – die Cloud der Thix-Apps: Zwischenablage, Notizen und Einstellungen auf allen Geräten, im Browser." />
<title>@(Model == brand.Name ? brand.Name : $"{Model} · {brand.Name}")</title>
<link rel="icon" type="image/svg+xml" href="@brand.Favicon" />
@if (brand.IsCloud)
{
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
}
else
{
    <link rel="apple-touch-icon" href="@brand.Icon256" />
}
<link rel="manifest" href="@manifest" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="@brand.Name" />
<script src="~/matui/matui.boot.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
